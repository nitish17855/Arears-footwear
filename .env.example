# ===================================================
# AREARS FOOTWEAR - ENVIRONMENT CONFIGURATION
# ===================================================

# Optional: PostgreSQL Database Connection String
# The application runs seamlessly with an in-memory fallback if unset.
DATABASE_URL="postgresql://postgres:password@localhost:5432/arears_db?schema=public"

# JWT Secret for Session & Authentication Tokens
JWT_SECRET="super-secret-jwt-key-arears-production-2026"

# Optional: Stripe Payment Gateway Configuration
# Instant Demo Pay works out-of-the-box without requiring live Stripe keys.
STRIPE_SECRET_KEY="sk_test_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
